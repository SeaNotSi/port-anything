{"id": "platform.windows_pc", "category": "platform", "name": "Windows PC", "version": "Windows 10 / 11", "description": "Primary source platform for most commercial PC games. x86-64 executables in PE format, Direct3D 9/11/12 or OpenGL/Vulkan rendering, Win32 input and audio APIs.", "compatibility": {"android": "not_applicable", "arm64": "not_applicable", "x86_64": "supported", "windows": "supported", "linux": "unsupported", "macos": "unsupported", "vulkan": "supported", "opengl_es": "unsupported", "status": "supported"}, "dependencies": ["fileformat.pe", "graphics.d3d11", "graphics.d3d12", "graphics.opengl", "graphics.vulkan"], "requirements": ["Original game installation owned by the user", "PE parser or disassembler for analysis"], "limitations": ["Win32, Direct3D and XInput must be replaced or translated on Android", "No native ARM64 binary in most titles"], "source": {"url": "https://learn.microsoft.com/en-us/windows/win32/", "type": "official_docs", "retrieved": "2026-11-21"}, "license": {"name": "Microsoft Windows EULA", "spdx": "LicenseRef-Microsoft-Proprietary"}, "verification": "verified", "last_verified": "2026-11-21", "tags": ["source-platform", "x86_64", "pe", "direct3d"]}
